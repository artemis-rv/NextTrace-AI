# Copy to .env (never commit .env). All values are read by nextrace.config.Settings.
NEXTRACE_DATABASE_URL=postgresql+psycopg2://nextrace_app:change-me@127.0.0.1:5432/nextrace
NEXTRACE_REDIS_URL=redis://127.0.0.1:6379/0
NEXTRACE_OBJECT_STORE_ROOT=./var/objects
# >= 32 random characters; used for HMAC pseudonyms of IPs in exports/explanations. Rotating it changes all pseudonyms.
NEXTRACE_PSEUDONYM_PEPPER=replace-with-32-plus-random-characters-from-a-secret-manager
# Retention (days). Header/flow metadata baseline = 6 months FIFO, subject to legal holds.
NEXTRACE_FLOW_RETENTION_DAYS=183
NEXTRACE_STATE_RETENTION_DAYS=183
NEXTRACE_STATE_EDGE_RETENTION_DAYS=14
NEXTRACE_FORECAST_RETENTION_DAYS=365
NEXTRACE_AUDIT_RETENTION_DAYS=730
NEXTRACE_HEADER_PCAP_RETENTION_DAYS=183
NEXTRACE_FULL_PCAP_RETENTION_HOURS=72
NEXTRACE_PCAP_BUDGET_BYTES=107374182400
# Temporal state window and live cache bounds
NEXTRACE_STATE_WINDOW_SECONDS=10
NEXTRACE_CACHE_MAX_STATES=360
NEXTRACE_CACHE_TTL_SECONDS=3600
# Uploads
NEXTRACE_UPLOAD_MAX_BYTES=2147483648

# ---- backend / pipeline (added with the backend layer) ----
NEXTRACE_ENVIRONMENT=dev
NEXTRACE_LOG_JSON=true
NEXTRACE_QUEUE_CAPACITY=1000
NEXTRACE_BACKPRESSURE_POLICY=block            # block | shed_oldest | reject
NEXTRACE_SEQUENCER_ALLOWED_LATENESS_S=30      # RESEARCH REQUIRED
NEXTRACE_SEQUENCE_LENGTH=20                   # RESEARCH REQUIRED
NEXTRACE_FORECAST_HORIZON_S=300               # RESEARCH REQUIRED
# Model artifacts: sha256 in the object store. Empty = slot unavailable (the pipeline reports it, never fakes output).
NEXTRACE_DETECTION_MODEL_SHA256=
NEXTRACE_PROGRESSION_MODEL_SHA256=
NEXTRACE_WORLD_MODEL_SHA256=
NEXTRACE_HEURISTIC_BASELINE_ENABLED=true
# Correlation / risk (weights recorded on every score)
NEXTRACE_CORRELATION_WINDOW_S=600
NEXTRACE_CORRELATION_GRACE_S=900
NEXTRACE_RISK_WEIGHTS_VERSION=w1-unvalidated
# Response policy: dry_run until a connector has passed verification tests in staging
NEXTRACE_ENFORCEMENT_MODE=dry_run
NEXTRACE_POLICY_AUTO_ALLOW_ENABLED=false
# LLM explanations are off by default; outputs are never evidence and cannot authorize actions
NEXTRACE_LLM_ENABLED=false
NEXTRACE_LLM_ENDPOINT=
NEXTRACE_LLM_API_KEY=
# API
NEXTRACE_API_RATE_LIMIT_PER_MINUTE=600
NEXTRACE_API_MAX_BODY_BYTES=1048576
